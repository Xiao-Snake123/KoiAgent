###############################################################################
# KoiAgent 环境变量配置
#
# 使用方式：复制本文件为 .env，然后填写
#   Windows      : copy .env.example .env
#   macOS/Linux  : cp .env.example .env
#
# 加载顺序：程序按 .env → .env.example 依次加载（后者不覆盖已存在的变量）。
# 若 API_KEY / COOKIES_STR 仍是下面的占位符，启动时程序会在终端**交互式提示**你输入，
# 并自动写回 .env。
#
# ⚠️ .env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库。
###############################################################################

# =============================================================================
# 【必填 1/3】大模型 API Key
# =============================================================================
# 获取方式：阿里云百炼控制台 https://bailian.console.aliyun.com/ → 右上角「API-KEY」→ 创建
# 格式类似：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# ⚠️ 关键要求：所选模型必须支持 **Function Calling（工具调用）**。
#    本项目的 Agent 依赖工具调用与结构化输出；不支持工具调用的模型会在运行时报错。
API_KEY=默认使用通义千问,apikey通过百炼模型平台获取

# =============================================================================
# 【必填 2/3】闲鱼网页端 Cookie
# =============================================================================
# 获取步骤：
#   1) 浏览器登录闲鱼网页版 https://www.goofish.com
#   2) 按 F12 打开开发者工具 → 切到 Network（网络）标签 → 筛选 Fetch/XHR
#   3) 随便点开一个请求 → 在 Request Headers 里找到 Cookie → 整行复制粘贴到这里
#
# ⚠️ Cookie 有效期较短，且自动化操作可能触发风控（滑块验证）。
#    失效时程序会提示你重新粘贴最新 Cookie，无需重启。
COOKIES_STR=your_cookies_here

# =============================================================================
# 【必填 3/3】模型接口地址与模型名
# =============================================================================
# 默认对接通义千问（阿里云百炼的 OpenAI 兼容端点）
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型选择建议（三者均支持工具调用）：
#   qwen-max    —— 效果最好、成本最高，适合对客回复质量优先
#   qwen-plus   —— 效果与成本均衡，**推荐日常线上使用**
#   qwen-turbo  —— 最快最便宜，适合压测、批量或预算敏感场景
MODEL_NAME=qwen-max

# ---- 想换其他厂商？下面是 OpenAI 兼容服务的示例，按需启用并同步修改上面两项 ----
# DeepSeek   : MODEL_BASE_URL=https://api.deepseek.com/v1           MODEL_NAME=deepseek-chat
# 智谱 GLM   : MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4  MODEL_NAME=glm-4-plus
# 月之暗面   : MODEL_BASE_URL=https://api.moonshot.cn/v1            MODEL_NAME=moonshot-v1-32k
# OpenAI     : MODEL_BASE_URL=https://api.openai.com/v1             MODEL_NAME=gpt-4o-mini
# 本地 Ollama: MODEL_BASE_URL=http://localhost:11434/v1             MODEL_NAME=qwen2.5:7b
#              （此时 API_KEY 随便填，例如 API_KEY=ollama）
#
# 提示：非「通义千问」系模型时，EMBEDDING_* 也需自行指向对应的向量模型（见 RAG 章节）。


# =============================================================================
# 平台行为（可选）
# =============================================================================
# 人工接管关键词：卖家发送该内容即在「人工接管 / AI 接管」之间切换，默认句号
TOGGLE_KEYWORDS=。
# 是否模拟真人打字延迟再发送（更自然，但会拉长响应时间）
SIMULATE_HUMAN_TYPING=False
# WebSocket 心跳间隔（秒）
HEARTBEAT_INTERVAL=15
# 心跳响应超时（秒）
HEARTBEAT_TIMEOUT=5
# Token 刷新间隔（秒），默认 1 小时
TOKEN_REFRESH_INTERVAL=3600
# Token 刷新失败后的重试间隔（秒）
TOKEN_RETRY_INTERVAL=300
# 人工接管自动退出时间（秒），超时后自动回到 AI 接管
MANUAL_MODE_TIMEOUT=3600
# 消息时效性过滤（毫秒）：超时消息直接丢弃，默认 5 分钟
MESSAGE_EXPIRE_TIME=300000


# =============================================================================
# Agent 编排（可选）
# =============================================================================
# ReAct 最大推理步数（工具调用循环上限）
AGENT_MAX_STEPS=4
# 单次送入模型的最大历史消息条数（短期记忆窗口）
AGENT_MAX_MESSAGES=20
# 审核 Agent 驳回后的最大返工轮数（Reflexion 反思循环上限）
#   设为 0 表示不返工；设大则质量更好但成本更高
AGENT_MAX_REFLECTIONS=1
# 是否启用审核 Agent（生产者-审核者模式）。false = 省一次 LLM 调用，直接输出草稿
CRITIC_ENABLED=true
# 提示词目录
PROMPT_DIR=prompts
# 本地知识库目录
KNOWLEDGE_DIR=knowledge


# =============================================================================
# RAG 向量检索（可选）
# =============================================================================
# 留空 EMBEDDING_MODEL 时，自动使用**本地关键词检索**，无需任何 API、零成本。
# 想开启真正的向量检索，填上向量模型名即可（通义千问示例：text-embedding-v3）
EMBEDDING_MODEL=
# 向量接口地址；留空则回退使用 MODEL_BASE_URL
EMBEDDING_BASE_URL=
# 向量接口密钥；留空则回退使用 API_KEY
EMBEDDING_API_KEY=
# 单次向量化批大小
EMBEDDING_BATCH_SIZE=16
# 每次检索返回的片段数
RAG_TOP_K=3
# 文档切片长度 / 切片重叠（字符数）
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=60
# 向量缓存路径（按内容哈希增量更新，避免重复调用向量接口产生费用）
RAG_STORE_PATH=data/vector_store.json


# =============================================================================
# 输入侧 Prompt 注入防护（可选）
# =============================================================================
# 总开关：关闭后不做注入检测（不建议在生产关闭）
GUARD_ENABLED=true
# 拦截阈值：命中规则的权重累加达到该值即拦截（越大约宽松）
GUARD_BLOCK_SCORE=5
# 最大输入长度（字符），超出截断，防止超长输入撑爆上下文
GUARD_MAX_INPUT=1000


# =============================================================================
# 可靠性（可选）
# =============================================================================
# 同时进行的 LLM 推理上限，平抑瞬时并发、保护下游配额
LLM_MAX_CONCURRENCY=4
# 连续失败多少次后触发熔断
CIRCUIT_FAILURE_THRESHOLD=5
# 熔断冷却时长（秒），冷却后自动半开探测恢复
CIRCUIT_RESET_TIMEOUT=60
# 降级兜底话术：LLM 异常时发给买家，避免「石沉大海」
#   留空则异常时不回复
FALLBACK_REPLY=稍等，我确认下再回复您
# 消息去重缓存容量与时间窗口（秒），防止重连/重复推送导致重复回复
DEDUP_CACHE_SIZE=2000
DEDUP_TTL=300
# 会话记忆最大 thread 数，以及空闲多久后淘汰（秒）
MEMORY_MAX_THREADS=500
MEMORY_TTL=7200
# 记忆清理检查周期（秒）
MEMORY_REAP_INTERVAL=60


# =============================================================================
# 可观测性与稳定性（可选）
# =============================================================================
# 日志级别：DEBUG / INFO / WARNING / ERROR（生产建议 INFO，DEBUG 非常啰嗦）
LOG_LEVEL=DEBUG
# 是否记录运行轨迹
TRACE_ENABLED=true
# 轨迹与指标输出目录（traces.jsonl / metrics.json）
TRACE_DIR=logs
# P95 耗时统计的样本上限
METRICS_SAMPLE_LIMIT=1000
# 单次 LLM 请求超时（秒）
LLM_TIMEOUT=30
# LLM 请求失败自动重试次数
LLM_MAX_RETRIES=2
# 成本单价覆盖（元 / 1K tokens）。不填则使用内置示例价格表（估算用，以官方计费为准）
# COST_INPUT_PER_1K=0.0024
# COST_OUTPUT_PER_1K=0.0096
# 可选：接入 Langfuse 做可视化追踪（需 pip install langfuse）
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com


# =============================================================================
# 运维 / MCP（可选）
# =============================================================================
# 容器健康检查的心跳文件路径
HEALTH_FILE=data/health.json
# 心跳允许的最大静默秒数，超过判定为不健康
HEALTH_MAX_AGE=180
# MCP Server 默认传输方式：stdio / streamable-http / sse
MCP_TRANSPORT=stdio
